// name: symbolicJacobianEntries
// keywords: NewBackend, differentiation, jacobian, adjoint, bidirectional, coloring, permutation
// status: correct
// teardown_command: rm -rf jacobianEntryPermutation* jac_*.txt
//
// Regression test for the row/column *placement* of the colored symbolic Jacobian
// evaluation paths.
//
// It deliberately does NOT look at simulation trajectories: a row/column permuted
// Jacobian still produces trajectories that match the reference solution (only the
// Newton convergence degrades), which is why symbolicJacobianEvaluation.mos cannot
// detect such a bug.
//
// Instead the actual numerical Jacobian entries that DASSL reports via LOG_JAC are
// compared for
//   -jacobian=symbolical               (uncolored forward evaluation -> trusted reference)
//   -jacobian=coloredSymbolical        (forward / column mode, column coloring)
//   -jacobian=coloredSymbolicalAdjoint (adjoint / row mode, row coloring)
//   -jacobian=bicoloredSymbolical      (star bicoloring, column + row phase)
// All four must return the very same matrix.  The uncolored `symbolical` evaluation
// uses neither the sparsity pattern nor any coloring and therefore is an independent
// reference for the three colored variants.
//
// The model has a hollow, non-symmetric sparsity pattern with pairwise distinct
// entries
//
//        d der(x)/dx  =  [  0   2   0   3 ]
//                        [  5   0   7   0 ]
//                        [  0  11   0  13 ]
//                        [ 17   0  19   0 ]
//
// so that any row permutation, column permutation or transposition moves at least
// one distinct value to a different location and is immediately visible.  Four
// scalar (non-array) states are used on purpose: the adjoint seed variables are
// held in a plain list, so only a scalar model can expose an ordering error in
// that list.  The pattern still admits two column colors and two row colors, i.e.
// the coloring-based compression is genuinely exercised.
//
// Before the fix in NBJacobian.jacobianSymbolicAdjoint (where the adjoint seed
// variable list was overwritten with the unreversed accumulator content) this test
// failed: coloredSymbolicalAdjoint returned P_r * J with P_r reversing the row
// order, and bicoloredSymbolical returned zero for every entry that is only
// recoverable from the row phase.
//
// Notes on the logged values:
//  * DASSL prints pd = J - cj*I, so the diagonal carries the -cj term.  The
//    -initialStepSize flag pins the step size, hence cj (= 1e5) and the single
//    reported Jacobian are reproducible.
//  * The variable names annotated for rows/columns stem from the global real
//    variable array and do not necessarily coincide with the Jacobian's own
//    variable order; only the numerical placement is asserted here.

loadString("
model jacobianEntryPermutation
  Real x1(start = 1.0, fixed = true);
  Real x2(start = 2.0, fixed = true);
  Real x3(start = 3.0, fixed = true);
  Real x4(start = 4.0, fixed = true);
equation
  der(x1) =  2.0*x2 +  3.0*x4;
  der(x2) =  5.0*x1 +  7.0*x3;
  der(x3) = 11.0*x2 + 13.0*x4;
  der(x4) = 17.0*x1 + 19.0*x3;
end jacobianEntryPermutation;
"); getErrorString();

setCommandLineOptions("--newBackend --generateDynamicJacobian=bidirectional"); getErrorString();

buildModel(jacobianEntryPermutation, stopTime = 1e-5, numberOfIntervals = 1, tolerance = 1e-6); getErrorString();

// uncolored forward evaluation - independent reference
system("./jacobianEntryPermutation -s=dassl -jacobian=symbolical -initialStepSize=1e-5 -lv=LOG_JAC 2>&1 | grep -o \"J(row=.*\" > jac_ref.txt");
readFile("jac_ref.txt");

// colored forward (column) evaluation
system("./jacobianEntryPermutation -s=dassl -jacobian=coloredSymbolical -initialStepSize=1e-5 -lv=LOG_JAC 2>&1 | grep -o \"J(row=.*\" > jac_fwd.txt");
system("diff jac_ref.txt jac_fwd.txt");

// colored adjoint (row) evaluation
system("./jacobianEntryPermutation -s=dassl -jacobian=coloredSymbolicalAdjoint -initialStepSize=1e-5 -lv=LOG_JAC 2>&1 | grep -o \"J(row=.*\" > jac_adj.txt");
system("diff jac_ref.txt jac_adj.txt");
readFile("jac_adj.txt");

// bidirectional (star bicoloring) evaluation
system("./jacobianEntryPermutation -s=dassl -jacobian=bicoloredSymbolical -initialStepSize=1e-5 -lv=LOG_JAC 2>&1 | grep -o \"J(row=.*\" > jac_bi.txt");
system("diff jac_ref.txt jac_bi.txt");
readFile("jac_bi.txt");

// Result:
